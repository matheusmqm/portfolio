---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { t, paths, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  tag: string;
  entries: CollectionEntry<'projects'>[];
}
const { lang, tag, entries } = Astro.props;
const u = t(lang);
const other: Lang = lang === 'pt' ? 'en' : 'pt';
---

<Base lang={lang} title={`${u.tagTitle} #${tag}`} altHref={paths.tag(other, tag)} current="projects">
  <div class="wrap">
    <a class="link back meta" href={paths.section(lang, 'projetos')}>{u.tagBack}</a>
    <section class="pj-head">
      <span class="label">{u.tagTitle}</span>
      <h1>#{tag}</h1>
    </section>
    <div class="grid" style="padding-bottom: var(--space-9)">
      {
        entries.map((e) => (
          <ProjectCard
            year={e.data.year}
            name={e.data.name}
            summary={e.data.summary?.[lang]}
            tags={e.data.tags}
            href={paths.project(lang, e.id)}
          />
        ))
      }
    </div>
  </div>
</Base>
