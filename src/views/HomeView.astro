---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProfileCard from '../components/ProfileCard.astro';
import Button from '../components/Button.astro';
import ExperienceRow from '../components/ExperienceRow.astro';
import FilterBar from '../components/FilterBar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { t, paths, social, owner, type Lang } from '../i18n/ui';
import SkillGroup from '../components/SkillGroup.astro';
import { experience, skills } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = t(lang);
const id = {
  experience: lang === 'pt' ? 'experiencia' : 'experience',
  projects: lang === 'pt' ? 'projetos' : 'projects',
  about: lang === 'pt' ? 'sobre' : 'about',
  skills: lang === 'pt' ? 'habilidades' : 'skills',
  contact: lang === 'pt' ? 'contato' : 'contact',
};

const entries = (await getCollection('projects')).sort(
  (a, b) => b.data.year - a.data.year || a.data.name.localeCompare(b.data.name),
);
const items = entries.map((e) => ({
  slug: e.id,
  year: e.data.year,
  name: e.data.name,
  summary: e.data.summary?.[lang],
  context: e.data.context?.[lang],
  did: e.data.did?.map((d) => d[lang]) ?? [],
  images: e.data.images.map((im) => ({ src: im.src, alt: im.alt[lang], caption: im.caption?.[lang] })),
  repo: e.data.links.repo,
  demo: e.data.links.demo,
  tags: e.data.tags,
  search: [e.data.name, e.data.summary?.[lang], ...e.data.tags].filter(Boolean).join(' ').toLowerCase(),
}));
const altHref = paths.home(lang === 'pt' ? 'en' : 'pt');
---

<Base lang={lang} altHref={altHref}>
  <section class="wrap hero">
    <span class="label">{u.heroLabel}</span>
    <h1>{owner}</h1>
    <ProfileCard lang={lang} />
    <div class="hero__grid">
      <div class="hero__main">
        <p class="lead hero__lead">{u.about[0]}</p>
        <div class="hero__actions">
          <Button variant="primary" href={`#${id.projects}`}>{u.ctaProjects}</Button>
          <Button variant="secondary" href={`#${id.contact}`}>{u.ctaContact}</Button>
        </div>
      </div>
      <div class="hero__statement" id={id.about}>
        <p>{u.about[1]}</p>
      </div>
    </div>
  </section>

  <section class="section" id={id.skills} aria-labelledby={`${id.skills}-title`}>
    <div class="wrap">
      <div class="section__head"><h2 id={`${id.skills}-title`}>{u.skillsTitle}</h2></div>
      <div class="skills">
        {skills.map((g) => <SkillGroup title={g.title[lang]} items={g.items} />)}
      </div>
    </div>
  </section>

  <section class="section" id={id.experience} aria-labelledby={`${id.experience}-title`}>
    <div class="wrap">
      <div class="section__head"><h2 id={`${id.experience}-title`}>{u.experience}</h2></div>
      {
        experience.map((e) => (
          <ExperienceRow
            role={e.role[lang]}
            org={e.org}
            from={e.from[lang]}
            to={e.to[lang]}
            results={e.results[lang]}
            stack={e.stack}
          />
        ))
      }
    </div>
  </section>

  <section class="section" id={id.projects} aria-labelledby={`${id.projects}-title`}>
    <div class="wrap">
      <div class="section__head"><h2 id={`${id.projects}-title`}>{u.projects}</h2></div>
      <FilterBar lang={lang} />
      <div id="view-list" class="rows">
        {
          items.map((i, n) => (
            <ProjectRow lang={lang} index={n} slug={i.slug} name={i.name} summary={i.summary} context={i.context} did={i.did} images={i.images} repo={i.repo} demo={i.demo} search={i.search} />
          ))
        }
      </div>
      <div id="view-grid" class="grid" hidden>
        {
          items.map((i) => (
            <ProjectCard name={i.name} summary={i.summary} search={i.search} />
          ))
        }
      </div>
      <p class="empty" id="no-results" role="status" hidden>{u.noResults}</p>
    </div>
  </section>

  <section class="section contact" id={id.contact} aria-labelledby={`${id.contact}-title`}>
    <div class="wrap">
      <span class="label contact__kicker">{u.contactKicker}</span>
      <h2 id={`${id.contact}-title`}>{u.contactTitle}</h2>
      <Button variant="link" class="contact__email" href={`mailto:${social.email}`}>{social.email}</Button>
      <div class="contact__links">
        <Button variant="link" href={social.github}>{u.github}</Button>
        <Button variant="link" href={social.linkedin}>{u.linkedin}</Button>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Melhoria progressiva: busca e grade/lista.
  (function () {
    var input = document.getElementById('project-search');
    var field = document.getElementById('search-field');
    var toggle = document.getElementById('view-toggle');
    var grid = document.getElementById('view-grid');
    var list = document.getElementById('view-list');
    var none = document.getElementById('no-results');
    var state = { q: '', view: 'list' };
    field.hidden = false;
    toggle.hidden = false;
    var kbd = document.getElementById('search-kbd');
    if (/Mac|iPhone|iPad/.test(navigator.platform)) kbd.textContent = '⌘ K';
    function apply() {
      var shown = 0;
      document.querySelectorAll('[data-search]').forEach(function (el) {
        var ok = (!state.q || el.getAttribute('data-search').indexOf(state.q) > -1);
        el.hidden = !ok;
        if (ok && el.offsetParent !== null) shown++;
      });
      grid.hidden = state.view !== 'grid';
      list.hidden = state.view !== 'list';
      shown = (state.view === 'grid' ? grid : list).querySelectorAll('[data-search]:not([hidden])').length;
      none.hidden = shown > 0;
    }
    input.addEventListener('input', function () { state.q = input.value.trim().toLowerCase(); apply(); });
    toggle.querySelectorAll('button').forEach(function (b) {
      b.addEventListener('click', function () {
        state.view = b.getAttribute('data-view');
        toggle.querySelectorAll('button').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
        apply();
      });
    });
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input.focus(); input.select(); }
    });
    // Detalhes: sem JS o painel fica aberto; com JS começa fechado e o botão aparece.
    document.querySelectorAll('.row__toggle').forEach(function (b) {
      var panel = document.getElementById(b.getAttribute('aria-controls'));
      var label = b.querySelector('.row__toggle-label');
      b.hidden = false;
      panel.hidden = true;
      b.addEventListener('click', function () {
        var open = b.getAttribute('aria-expanded') !== 'true';
        b.setAttribute('aria-expanded', open ? 'true' : 'false');
        panel.hidden = !open;
        label.textContent = open ? b.getAttribute('data-open') : b.getAttribute('data-closed');
      });
    });
    apply();
  })();
</script>
