---
import { t, social, type Lang } from '../i18n/ui';
import { profile } from '../data/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = t(lang);
---

<aside class="profile-card">
  <dl class="profile">
    {
      profile.map((f) => (
        <div>
          <dt class="label label--muted">{u[f.key]}</dt>
          <dd>{f.value[lang]}</dd>
        </div>
      ))
    }
  </dl>
  <div class="profile__links">
    <a class="link" href={social.github}>{u.github}</a>
    <a class="link" href={social.linkedin}>{u.linkedin}</a>
  </div>
</aside>
