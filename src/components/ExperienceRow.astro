---
import Hashtag from './Hashtag.astro';
interface Props {
  role: string;
  org: string;
  from: string;
  to: string;
  results: string[];
  stack: string[];
}
const { role, org, from, to, results, stack } = Astro.props;
---

<div class="exp">
  <div class="exp__when">
    <p class="exp__dates"><span>{from}</span><span class="exp__arrow" aria-hidden="true"></span><span>{to}</span></p>
  </div>
  <div>
    <h3 class="exp__role">{role}</h3>
    <p class="exp__org">{org}</p>
    <ul class="exp__list">{results.map((r) => <li>{r}</li>)}</ul>
    <div class="tags">{stack.map((s) => <Hashtag tag={s} />)}</div>
  </div>
</div>
