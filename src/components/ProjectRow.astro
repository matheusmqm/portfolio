---
import { t, type Lang } from '../i18n/ui';
interface Image {
  src: string;
  alt: string;
  caption?: string;
}
interface Props {
  lang: Lang;
  slug: string;
  name: string;
  summary?: string;
  context?: string;
  did: string[];
  images: Image[];
  repo?: string;
  demo?: string;
  search: string;
}
const { lang, slug, name, summary, context, did, images, repo, demo, search } =
  Astro.props;
const u = t(lang);
const thumb = images[0]?.src;
const [hero, ...rest] = images;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (src: string) => (src.startsWith('/') ? base + src : src);
const panelId = `proj-${slug}`;
---

<article class:list={['row', thumb && 'row--has-thumb']} data-search={search}>
  <div class="row__body">
    <h3 class="row__title">{name}</h3>
    {summary && <p class="row__summary">{summary}</p>}
  </div>
  {thumb && <img class="row__thumb" src={url(thumb)} alt="" loading="lazy" width="176" height="110" />}
  <button
    type="button"
    class="row__toggle"
    aria-expanded="false"
    aria-controls={panelId}
    data-open={u.hide}
    data-closed={u.details}
    hidden
  >
    <span class="row__toggle-label">{u.details}</span><span class="sr-only"> {name}</span>
  </button>
  <div class="row__panel" id={panelId}>
    <div class="row__cols">
      {
        did.length > 0 && (
          <div class="row__did">
            <span class="label">{u.did}</span>
            <ul class="row__did-list">{did.map((d) => <li class="row__did-item">{d}</li>)}</ul>
          </div>
        )
      }
      <div class="row__side">
        {
          context && (
            <div>
              <span class="label">{u.context}</span>
              <p>{context}</p>
            </div>
          )
        }
        <div class="row__links">
          {
            repo && (
              <a class="link row__repo" href={repo} target="_blank" rel="noopener noreferrer">
                {u.viewOnGithub} ↗<span class="sr-only"> {name}</span>
              </a>
            )
          }
          {
            demo && (
              <a class="link row__demo" href={demo} target="_blank" rel="noopener noreferrer">
                {u.demo} ↗<span class="sr-only"> {name}</span>
              </a>
            )
          }
        </div>
        {
          hero && (
            <figure class="row__fig">
              <img src={url(hero.src)} alt={hero.alt} loading="lazy" width="1600" height="1000" />
              {hero.caption && <figcaption>{hero.caption}</figcaption>}
            </figure>
          )
        }
      </div>
    </div>
    {
      rest.length > 0 && (
        <div class="row__gallery">
          {rest.map((im) => (
            <figure class="row__fig">
              <img src={url(im.src)} alt={im.alt} loading="lazy" width="1600" height="1000" />
              {im.caption && <figcaption>{im.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )
    }
  </div>
</article>
