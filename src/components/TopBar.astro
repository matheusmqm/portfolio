---
import LangSwitch from './LangSwitch.astro';
import { t, paths, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
  current?: 'projects' | 'experience' | 'skills' | 'contact';
  altHref: string;
}
const { lang, current, altHref } = Astro.props;
const u = t(lang);
const items = [
  { key: 'projects', href: paths.section(lang, 'projetos') },
  { key: 'experience', href: paths.section(lang, 'experiencia') },
  { key: 'skills', href: paths.section(lang, 'habilidades') },
  { key: 'contact', href: paths.section(lang, 'contato') },
] as const;
---

<header class="wrap">
  <div class="topbar">
    <a class="topbar__brand" href={paths.home(lang)}>matheus</a>
    <div class="topbar__right">
      <nav class="nav" aria-label={u.navLabel}>
        {
          items.map((i) => (
            <a href={i.href} aria-current={current === i.key ? 'page' : undefined}>
              {u.nav[i.key]}
            </a>
          ))
        }
      </nav>
      <LangSwitch lang={lang} altHref={altHref} />
    </div>
  </div>
</header>
