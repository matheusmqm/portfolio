---
import SearchField from './SearchField.astro';
import { t, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = t(lang);
---

<div class="toolbar">
  <SearchField placeholder={u.searchPlaceholder} label={u.searchLabel} />
  <div class="toolbar__row">
    <div class="view-toggle" role="group" aria-label={u.viewLabel} id="view-toggle" hidden>
      <button type="button" data-view="list" aria-pressed="true">{u.list}</button>
      <button type="button" data-view="grid" aria-pressed="false">{u.grid}</button>
    </div>
  </div>
</div>
