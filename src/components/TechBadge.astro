---
import { tech } from '../data/site';
interface Props {
  tag: string;
  /** Com `label`, mostra ícone + nome (painel). Sem, só o ícone (linha). */
  label?: boolean;
}
const { tag, label = false } = Astro.props;
const meta = tech[tag] ?? { label: tag };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<span class:list={['techb', label ? 'techb--label' : 'techb--icon']} title={meta.label}>
  {
    meta.icon ? (
      <span class="techb__icon" style={`--icon:url(${base}/icons/${meta.icon}.svg)`} aria-hidden="true" />
    ) : (
      !label && <span class="techb__init" aria-hidden="true">{meta.label.slice(0, 2)}</span>
    )
  }
  {label ? <span class="techb__name">{meta.label}</span> : <span class="sr-only">{meta.label}</span>}
</span>
