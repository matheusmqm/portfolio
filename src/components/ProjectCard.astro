---
import { Image } from 'astro:assets';
interface Props {
  name: string;
  summary?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  search?: string;
}
const { name, summary, image, imageAlt = '', search = '' } = Astro.props;
---

<article class="card" data-search={search}>
  {
    image && (
      <div class="card__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 800]}
          sizes="(min-width: 900px) 360px, 100vw"
          formats={['avif', 'webp']}
          loading="lazy"
        />
      </div>
    )
  }
  <h3 class="card__title">{name}</h3>
  {summary && <p class="card__summary">{summary}</p>}
</article>
