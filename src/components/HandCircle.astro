---
// Traço à mão que se desenha uma vez (CSS puro). O SVG é decorativo; a palavra continua no HTML.
interface Props {
  kind?: 'circle' | 'ellipse' | 'underline';
  plain?: boolean;
}
const { kind = 'circle', plain = false } = Astro.props;
const shapes = {
  circle: {
    vb: '0 0 200 100',
    d: 'M 58 18 C 98 2, 164 8, 186 38 C 204 66, 166 94, 108 92 C 50 90, 12 68, 20 38 C 28 12, 90 4, 132 12 C 146 15, 152 20, 154 26',
  },
  ellipse: {
    vb: '0 0 240 100',
    d: 'M 34 24 C 70 4, 170 2, 212 22 C 240 36, 228 78, 188 90 C 138 102, 50 96, 22 68 C 4 48, 32 20, 92 10 C 120 5, 150 5, 164 9',
  },
  underline: {
    vb: '0 0 240 20',
    d: 'M 4 12 C 24 4, 40 18, 62 10 C 84 2, 100 17, 122 10 C 144 3, 160 17, 182 9 C 204 2, 220 14, 236 8',
  },
} as const;
const s = shapes[kind];
---

<span class:list={['circled', { 'circled--plain': plain || kind === 'underline' }]}><slot /><svg
    class={`hand hand--${kind}`}
    viewBox={s.vb}
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"><path d={s.d} pathLength="1"></path></svg
  ></span
>
