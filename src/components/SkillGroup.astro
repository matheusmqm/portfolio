---
import { iconFile, type Skill } from '../data/site';
interface Props {
  title: string;
  items: Skill[];
}
const { title, items } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="skillgroup">
  <h3 class="skillgroup__title">{title}</h3>
  <ul class="skillgroup__list">
    {
      items.map((s) => (
        <li class="skill">
          <span class="skill__icon" style={`--icon:url(${base}/icons/${iconFile(s.icon)})`} aria-hidden="true" />
          <span class="skill__name">{s.name}</span>
        </li>
      ))
    }
  </ul>
</div>
